{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "eslint-plugin-security",
          "version": "4.0.1",
          "informationUri": "https://github.com/eslint-community/eslint-plugin-security",
          "rules": [
            {
              "id": "security/detect-bidi-characters",
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "security/detect-buffer-noassert",
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "security/detect-child-process",
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "security/detect-disable-mustache-escape",
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "security/detect-eval-with-expression",
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "security/detect-new-buffer",
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "security/detect-no-csrf-before-method-override",
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "security/detect-non-literal-require",
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "security/detect-pseudoRandomBytes",
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "security/detect-unsafe-regex",
              "defaultConfiguration": {
                "level": "warning"
              }
            }
          ]
        }
      },
      "results": [
