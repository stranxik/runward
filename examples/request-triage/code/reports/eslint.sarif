{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "ESLint",
          "informationUri": "https://eslint.org",
          "rules": [
            {
              "id": "no-eval",
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "no-implied-eval",
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "no-new-func",
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "no-restricted-globals",
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "no-restricted-imports",
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "no-restricted-syntax",
              "defaultConfiguration": {
                "level": "error"
              }
            }
          ]
        }
      },
      "columnKind": "utf16CodeUnits",
      "results": []
    }
  ]
}
