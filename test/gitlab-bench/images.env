# The images the GitLab bench runs, pinned by digest (read by bench.sh and checked by
# test/unit/gitlab-bench.test.js). A digest is the manifest-list digest Docker Hub reports for the
# tag in the comment, read on 2026-10-13. Bumping one is a deliberate change: re-run the bench with
# update_fixtures=true and commit the recorded fixtures with the new version (docs/gitlab-bench.md).

# gitlab/gitlab-ce:19.4.2-ce.0
GITLAB_IMAGE=gitlab/gitlab-ce@sha256:b65c3ece044d125254b4c4a99b10676bbd2502f05f8c628cb60628f44f4df11b
# gitlab/gitlab-runner:v19.4.1 (Ubuntu flavour)
RUNNER_IMAGE=gitlab/gitlab-runner@sha256:77d03a5c881ff8f97381de4f96a66c080733eeab9c9cf502bd19916a18969113
# gitlab/gitlab-runner-helper:ubuntu-v19.4.1
HELPER_IMAGE=gitlab/gitlab-runner-helper@sha256:7e2405950126b5be6778fc2daff2fa661e759f6ec78a6ef38fbceba87fbb9560
# node:22 (Debian bookworm): the job image and the image of the local package server
NODE_IMAGE=node@sha256:0e5f906573693feaa1e21057ebdcfdb5bd5021f050b2dc7c9deceb629c7da2a8
