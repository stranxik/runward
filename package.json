{
  "name": "runward",
  "version": "0.37.0",
  "description": "After the spec: ship and run. A delivery framework for agentic systems — floor first, evolution on evidence, governance from day zero, handover with proof.",
  "keywords": [
    "agentic",
    "ai-agents",
    "spec-driven",
    "delivery",
    "governance",
    "llm",
    "architecture"
  ],
  "author": "Thibault Souris",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stranxik/runward.git"
  },
  "homepage": "https://runward.dev",
  "bugs": {
    "url": "https://github.com/stranxik/runward/issues"
  },
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "runward": "dist/cli.js"
  },
  "exports": {
    "./claims": "./dist/lib/claims-rules.js",
    "./package.json": "./package.json",
    "./*": "./*"
  },
  "files": [
    "dist",
    "templates",
    "regimes",
    "examples/request-triage/AGENTS.md",
    "examples/request-triage/runward",
    "examples/request-triage/code/src",
    "examples/request-triage/code/test",
    "examples/request-triage/code/package.json",
    "examples/request-triage/code/tsconfig.json",
    "examples/request-triage/code/README.md",
    "README.md",
    "NOTICE.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test test/unit/*.test.js && node test/smoke.js && node test/oscal-schema.js && node test/intoto-schema.js && node test/spelling-conformance.js && node test/sarif-shape.js && node test/audit-corpus.js",
    "test:unit": "npm run build && node --test test/unit/*.test.js",
    "coverage": "npm run build && node --test --experimental-test-coverage test/unit/*.test.js",
    "prepublishOnly": "npm run build && node --test test/unit/*.test.js && node test/smoke.js && node test/oscal-schema.js",
    "test:audit": "npm run build && node test/audit-corpus.js",
    "bench": "npm run build && node test/bench-scale.js",
    "mutation": "npm run build && stryker run",
    "mutation:module": "npm run build && stryker run --mutate",
    "mutation:chunks": "npm run build && scripts/mutation-chunked.sh",
    "mutation:survivors": "node scripts/mutation-survivors.mjs",
    "mutation:wholenet": "node scripts/mutation-wholenet.mjs"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "chalk": "^6.0.0",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.1",
    "@types/node": "^26.1.1",
    "ajv": "^8.20.0",
    "ajv-draft-04": "^1.0.0",
    "ajv-formats": "^3.0.1",
    "js-yaml": "^5.2.1",
    "typescript": "^5.5.0"
  }
}
