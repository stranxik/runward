{
  "format": "runward-assess-secret-patterns/1",
  "about": "High-confidence credential shapes only: a pattern that cries on honest text gets a scan switched off. The control credentials that prove the scan sees are assembled at run time (src/measure.js), never written in a file. A documented example key is inert and public: it is listed by fingerprint (sha256 of pattern id and match, 16 hex), never spelled.",
  "patterns": [
    {
      "id": "aws-access-key-id",
      "re": "\\b(?:AKIA|ASIA)[0-9A-Z]{16}\\b"
    },
    {
      "id": "github-token",
      "re": "\\bgh[pousr]_[A-Za-z0-9]{36,255}\\b"
    },
    {
      "id": "github-fine-grained-token",
      "re": "\\bgithub_pat_[A-Za-z0-9_]{60,255}\\b"
    },
    {
      "id": "npm-token",
      "re": "\\bnpm_[A-Za-z0-9]{36}\\b"
    },
    {
      "id": "slack-token",
      "re": "\\bxox[abprs]-[A-Za-z0-9-]{10,72}\\b"
    },
    {
      "id": "stripe-live-secret",
      "re": "\\b[rs]k_live_[A-Za-z0-9]{20,99}\\b"
    },
    {
      "id": "anthropic-key",
      "re": "\\bsk-ant-[A-Za-z0-9_-]{32,255}\\b"
    },
    {
      "id": "openai-project-key",
      "re": "\\bsk-proj-[A-Za-z0-9_-]{32,255}\\b"
    },
    {
      "id": "google-api-key",
      "re": "\\bAIza[0-9A-Za-z_-]{35}\\b"
    },
    {
      "id": "private-key-block",
      "re": "-----BEGIN (?:RSA |EC |OPENSSH |DSA |PGP |ENCRYPTED )?PRIVATE KEY(?: BLOCK)?-----"
    }
  ],
  "skip": {
    "maxBlobBytes": 4000000,
    "binaryProbeBytes": 8000
  },
  "documentedExamples": [
    {
      "pattern": "aws-access-key-id",
      "fingerprint": "d0dead6eceff137c",
      "why": "the access key id AWS prints in its own documentation; every scanner exempts it, and no credential matches it"
    }
  ]
}
