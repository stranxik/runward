    "directory": "packages/runward-assess"
  },
  "homepage": "https://github.com/stranxik/runward/tree/main/packages/runward-assess#readme",
  "bin": {
    "runward-assess": "bin/runward-assess.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./score": "./src/score.js",
    "./canon": "./src/canon.js"
  },
  "files": ["bin", "src", "grid", "corpus", "README.md", "LICENSE"],
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=22.12.0"
