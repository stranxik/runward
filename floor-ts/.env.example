# Real-mode configuration (optional).
#
# Without this file, or without MODEL_API_KEY, the floor runs in deterministic
# echo mode: no key, no network call, everything reproducible.
#
# To enable a real provider: copy this file to .env, fill in the key and the
# provider URL, then run the demo.
#   cp .env.example .env

# Provider API key. Its presence switches the floor to real mode.
# Leave empty to stay in deterministic echo mode.
MODEL_API_KEY=

# Provider base URL, OpenAI-API-compatible (/chat/completions endpoint).
# Replace with your provider's URL. Examples:
#   OpenAI   : https://api.openai.com/v1
#   LiteLLM  : http://localhost:4000/v1   (or your proxy URL)
#   Novita   : https://api.novita.ai/v3/openai
MODEL_BASE_URL=https://api.openai.com/v1

# Per-tier model names (three-tier gateway: fast / balanced / deep).
# If only one is set, it serves all three. Examples (adapt to your provider):
#   MODEL_NAME_FAST=gpt-4o-mini
#   MODEL_NAME_BALANCED=gpt-4o
#   MODEL_NAME_DEEP=o1
MODEL_NAME_FAST=
MODEL_NAME_BALANCED=
MODEL_NAME_DEEP=

# Maximum output tokens per model call (default: 1024).
# Always sent in the request body; required by some providers.
# MODEL_MAX_TOKENS=1024

# Per-run cost caps (governance from day zero). Beyond them, the orchestrator
# stops and returns a partial synthesis (status "capped").
# MAX_TOOL_CALLS=16
# MAX_MODEL_CALLS=4

# Log level: debug | info | warn | error (default: info).
# LOG_LEVEL=info
